VITE_MAIN_SERVER_URL=http://localhost:4000
VITE_AI_SERVER_URL=http://localhost:4100

# Same Web OAuth client ID as GOOGLE_CLIENT_ID in server/.env and
# serverClientId in capacitor.config.ts - needed here too so Google Sign-In
# works when testing in a browser via `npm run dev` (native builds get it
# from capacitor.config.ts instead).
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
