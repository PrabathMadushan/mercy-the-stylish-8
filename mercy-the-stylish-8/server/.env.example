PORT=4000

# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Use the WEB client ID here (same one referenced in app/capacitor.config.ts)
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Any long random string - used to sign session JWTs
JWT_SECRET=change-this-to-a-long-random-string

# Comma separated list of emails that should get dashboard/admin access
ADMIN_EMAILS=you@example.com

# Where the JSON data files live (auto-created). Leave default for local/dev.
DATA_DIR=./data
