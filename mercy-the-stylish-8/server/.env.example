PORT=4000

# PostgreSQL connection (use docker-compose postgres or a hosted DB)
DATABASE_URL=postgresql://mercy:mercy@localhost:5432/mercy?schema=public

# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Any long random string - used to sign session JWTs
JWT_SECRET=change-this-to-a-long-random-string

# Comma separated list of emails that should get dashboard/admin access
ADMIN_EMAILS=you@example.com

# Frontend URL for CORS and Stripe redirect URLs
FRONTEND_URL=http://localhost:5173

# Stripe (test keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
