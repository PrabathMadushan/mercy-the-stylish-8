FROM node:22-alpine

WORKDIR /app

RUN apk add --no-cache openssl

# Copy npm config first (retries for flaky networks)
COPY .npmrc package.json package-lock.json* ./
COPY prisma.config.ts ./
COPY prisma ./prisma

# prisma.config.ts requires DATABASE_URL for generate; no live DB connection during build
ENV DATABASE_URL=postgresql://mercy:mercy@postgres:5432/mercy?schema=public

RUN npm install || (sleep 5 && npm install) || (sleep 10 && npm install)

RUN ./node_modules/.bin/prisma generate

COPY tsconfig.json ./
COPY src ./src
COPY docker-entrypoint.dev.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 4000

ENTRYPOINT ["/entrypoint.sh"]
